# Copy to .env.local and set secrets locally. Do not commit .env.local.
STUDY_BACKEND_HOST=127.0.0.1
STUDY_BACKEND_PORT=8103
STUDY_FRONTEND_HOST=127.0.0.1
STUDY_FRONTEND_PORT=5103
STUDY_PUBLIC_ORIGIN=http://127.0.0.1:5103
STUDY_ALLOWED_ORIGINS=http://127.0.0.1:5103
# Local HTTP only. Public deployments must use HTTPS and set this to 0.
STUDY_COOKIE_INSECURE=1
STUDY_SESSION_COOKIE=english_study_session
STUDY_INITIAL_PASSWORD=
STUDY_LOGIN_MAX_FAILURES=5
STUDY_LOGIN_WINDOW_SECONDS=600
STUDY_AI_BASE_URL=
STUDY_AI_API_KEY=
STUDY_AI_MODEL=
STUDY_AI_TEMPERATURE=1
STUDY_AI_REASONING_EFFORT=
STUDY_AI_TIMEOUT_SECONDS=120
STUDY_AI_DISABLE_THINKING=
STUDY_ENGLISH_AI_BASE_URL=
STUDY_ENGLISH_AI_API_KEY=
STUDY_ENGLISH_AI_MODEL=
STUDY_ENGLISH_AI_TEMPERATURE=1
STUDY_ENGLISH_AI_REASONING_EFFORT=
STUDY_ENGLISH_AI_TIMEOUT_SECONDS=
STUDY_ENGLISH_AI_DISABLE_THINKING=
STUDY_ENGLISH_SENTENCE_AUDIO_PROVIDER=edge
STUDY_ENGLISH_EDGE_VOICE=en-US-JennyNeural
STUDY_ENGLISH_WORD_AUDIO_VOICE=en-US-AriaNeural
