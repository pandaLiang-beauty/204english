# Copy to .env.local and set secrets locally. Do not commit .env.local.
STUDY_BACKEND_HOST=127.0.0.1
STUDY_BACKEND_PORT=8204
STUDY_FRONTEND_HOST=127.0.0.1
STUDY_FRONTEND_PORT=5204
STUDY_PUBLIC_ORIGIN=http://127.0.0.1:5204
STUDY_ALLOWED_ORIGINS=http://127.0.0.1:5204
# Local HTTP only. Public deployments must use HTTPS and set this to 0.
STUDY_COOKIE_INSECURE=1
STUDY_SESSION_COOKIE=english_study_session
STUDY_INITIAL_PASSWORD=
STUDY_LOGIN_MAX_FAILURES=5
STUDY_LOGIN_WINDOW_SECONDS=600
# 英语翻译 AI 配置请复制 .env.secrets.example 为 .env.secrets.local，勿写入本文件。
STUDY_ENGLISH_SENTENCE_AUDIO_PROVIDER=edge
STUDY_ENGLISH_EDGE_VOICE=en-US-JennyNeural
STUDY_ENGLISH_WORD_AUDIO_VOICE=en-US-AriaNeural
STUDY_ENGLISH_KOKORO_VOICE=af_heart
STUDY_ENGLISH_KOKORO_MODEL_DIR=
STUDY_INSTALL_TTS=0
# Optional one-round override for testing the automatic review-cycle rollover.
STUDY_ENGLISH_REVIEW_ROUND_TEST_ID=
STUDY_ENGLISH_REVIEW_ROUND_TEST_EXPIRES_AT=
